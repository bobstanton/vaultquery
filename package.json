{
	"name": "vaultquery",
	"version": "1.2.0",
	"description": "Query notes and frontmatter through a local SQLite index with output to table, chart or calendar.",
	"main": "main.js",
	"types": "index.d.ts",
	"files": [
		"main.js",
		"index.d.ts",
		"api.js",
		"api.d.ts",
		"provider-types.d.ts"
	],
	"exports": {
		".": {
			"types": "./index.d.ts",
			"require": "./main.js",
			"import": "./main.js",
			"default": "./main.js"
		},
		"./provider-types": {
			"types": "./provider-types.d.ts"
		},
		"./api": {
			"types": "./api.d.ts",
			"require": "./api.js",
			"import": "./api.js",
			"default": "./api.js"
		}
	},
	"scripts": {
		"rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
		"build-help-generator": "npm --prefix node_modules/md-to-obsidian-dom run build",
		"generate-help": "md-to-obsidian-dom ./help-md ./src/generated-help --prefix vaultquery-help --grammar ./help-grammar.mjs",
		"generate-api-types": "rollup -c rollup.dts.mjs && node scripts/generate-api-dts.mjs",
		"generate": "npm run generate-help && npm run generate-api-types",
		"dev": "npm run generate && node esbuild.config.mjs && npm run rename",
		"build": "npm run generate && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && npm run rename",
		"version": "node version-bump.mjs && git add manifest.json versions.json && npm run rename",
		"lint": "node ../vaultquery-tests/node_modules/eslint/bin/eslint.js . --config ../vaultquery-tests/eslint.config.mjs",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"review": "npm run lint && npm run typecheck && npm run build",
		"prepare": "npm run build"
	},
	"keywords": [],
	"author": "Bob Stanton",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@lezer/common": "^1.5.3",
		"@types/fnv-plus": "^1.3.2",
		"@types/node": "^26.6.5",
		"@types/papaparse": "^5.5.2",
		"@types/sql.js": "^1.4.11",
		"esbuild": "^0.28.2",
		"esbuild-plugin-inline-worker": "^0.1.1",
		"md-to-obsidian-dom": "github:bobstanton/md-to-obsidian-dom#ac1da9e441ae5830780706a773863648e8718dfa",
		"obsidian": "^1.14.4",
		"prismjs": "^1.30.0",
		"rollup": "^4.64.12",
		"rollup-plugin-dts": "^6.5.1",
		"tslib": "2.8.1",
		"typescript": "6.0.3"
	},
	"dependencies": {
		"@fullcalendar/core": "^6.1.22",
		"@fullcalendar/daygrid": "^6.1.22",
		"@fullcalendar/interaction": "^6.1.22",
		"@fullcalendar/timegrid": "^6.1.22",
		"@xmldom/xmldom": "0.9.12",
		"chart.js": "^4.5.1",
		"exifreader": "^4.51.0",
		"fnv-plus": "^1.3.1",
		"markdown-table": "^3.0.4",
		"obsidian-debug-logger": "git+https://github.com/bobstanton/obsidian-debug-logger.git",
		"papaparse": "^5.7.0",
		"placeholder-resolver": "git+https://github.com/bobstanton/placeholder-resolver.git#3ed9fc1ae04e27681788906046065f1cb7112c4f",
		"slickgrid": "^5.20.2",
		"sql.js": "1.14.2",
		"user-template-renderer": "git+https://github.com/bobstanton/user-template-renderer.git"
	},
	"overrides": {
		"fast-uri": "^4.1.2",
		"typescript": "6.0.3"
	}
}
