{
	"name": "vaultquery",
	"version": "1.0.6",
	"description": "Query notes and frontmatter through a local SQLite index with output to table, chart or calendar.",
	"main": "main.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"require": "./main.js",
			"import": "./main.js",
			"default": "./main.js"
		},
		"./api": {
			"types": "./api.d.ts",
			"require": "./api.js",
			"import": "./api.js",
			"default": "./api.js"
		}
	},
	"scripts": {
		"rename": "node -e \"require('fs').rename('main.css', 'styles.css', () => { })\"",
		"build-help-generator": "cd ../md-to-obsidian-dom && npm run build",
		"generate-help": "node ../md-to-obsidian-dom/dist/bin/generate.js ./help-md ./src/generated-help --prefix vaultquery-help",
		"generate-api-types": "node scripts/generate-api-dts.mjs",
		"generate": "npm run generate-help && npm run generate-api-types",
		"dev": "npm run generate && node esbuild.config.mjs && npm run rename",
		"build": "npm run generate && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production && npm run rename",
		"version": "node version-bump.mjs && git add manifest.json versions.json && npm run rename",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"obsidian-review": "node ../obsidian-plugin-review/dist/cli.js run --repo . --type plugin",
		"review": "npm run lint && npm run typecheck && npm run build && npm run obsidian-review"
	},
	"keywords": [],
	"author": "Bob Stanton",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.2",
		"@codemirror/language": "6.12.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@lezer/common": "^1.5.2",
		"@microsoft/eslint-plugin-sdl": "^1.1.0",
		"@types/fnv-plus": "^1.3.2",
		"@types/node": "^25.6.0",
		"@types/sql.js": "^1.4.11",
		"@typescript-eslint/eslint-plugin": "^8.58.2",
		"@typescript-eslint/parser": "^8.58.2",
		"esbuild": "^0.28.0",
		"esbuild-plugin-inline-worker": "^0.1.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.2.4",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@fullcalendar/core": "^6.1.20",
		"@fullcalendar/daygrid": "^6.1.20",
		"@fullcalendar/interaction": "^6.1.20",
		"@fullcalendar/timegrid": "^6.1.20",
		"chart.js": "^4.5.1",
		"fnv-plus": "^1.3.1",
		"markdown-table": "^3.0.4",
		"obsidian-debug-logger": "file:../obsidian-debug-logger",
		"placeholder-resolver": "file:../placeholder-resolver",
		"slickgrid": "^5.18.3",
		"sql.js": "^1.14.1",
		"user-template-renderer": "file:../user-template-renderer"
	},
	"overrides": {
		"fast-uri": "3.1.2"
	}
}
